{
  "manifest_version": 3,
  "name": "Video Saver",
  "version": "0.4.0",
  "description": "Find videos on the current page and save them for offline viewing.",
  "permissions": [
    "webRequest",
    "storage",
    "scripting",
    "downloads",
    "tabs",
    "webNavigation",
    "declarativeNetRequestWithHostAccess",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Video Saver",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "detect.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "common.js",
        "hls.js",
        "dash.js",
        "resolvers.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
