{
  "manifest_version": 3,
  "name": "Video Saver",
  "version": "0.5.0",
  "description": "Find videos on the current page and save them for offline viewing.",
  "key": "",
  "permissions": [
    "webRequest",
    "storage",
    "scripting",
    "downloads",
    "tabs",
    "webNavigation",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Video Saver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "compat.js",
        "detect.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "compat.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "compat.js",
        "youtube.js"
      ],
      "css": [
        "youtube.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "compat.js",
        "popup.html",
        "popup.css",
        "popup.js",
        "common.js",
        "hls.js",
        "dash.js",
        "resolvers.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
