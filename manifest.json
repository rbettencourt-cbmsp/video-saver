{
  "manifest_version": 3,
  "name": "Video Saver",
  "version": "0.2.0",
  "description": "Find videos on the current page and save them for offline viewing.",
  "permissions": [
    "webRequest",
    "storage",
    "scripting",
    "downloads",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Video Saver",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
